"ca","@value":"Tela que serveix de suport per a treballs pictòrics"},{"@language":"nl","@value":"Stevig weefsel van hennep, vlas of katoen"},{"@language":"en","@value":"Extremely heavy-duty plain-woven fabric"},{"@language":"sl","@value":"Izredno trpežna navadna tkanina"},{"@language":"cs","@value":"Druh tkaniny"},{"@language":"es","@value":"Tela extremadamente resistente utilizada en velas, lonas, mochilas, obras pictóricas..."},{"@language":"de","@value":"Festes, strapazierfähiges Gewebe in Leinwandbindung"},{"@language":"fr","@value":"Pièce de tissu résistante"},{"@language":"pl","@value":"Rodzaj wyjątkowo wytrzymałej, gładkiej tkaniny używanej w malarstwie olejnym"},{"@language":"sv","@value":"Tygmaterial"}],"skos:prefLabel":[{"@language":"ru","@value":"Холст"},{"@language":"fi","@value":"Kangas"},{"@language":"pt","@value":"Tela"},{"@language":"lv","@value":"Audekls"},{"@language":"et","@value":"Lõuend"},{"@language":"es","@value":"Lienzo"},{"@language":"ga","@value":"Canbhás"},{"@language":"fr","@value":"Toile"},{"@language":"sv","@value":"Kanvas"},{"@language":"hu","@value":"Vászon"},{"@language":"de","@value":"Leinwand"},{"@language":"bg","@value":"Брезент"},{"@language":"it","@value":"Canovaccio"},{"@language":"el","@value":"Μουσαμάς"},{"@language":"en","@value":"Canvas"},{"@language":"nl","@value":"Canvas"},{"@language":"ro","@value":"Pânză (pictură)"},{"@language":"lt","@value":"Drobė"},{"@language":"ca","@value":"Llenç"},{"@language":"sl","@value":"Platno"},{"@language":"da","@value":"Lærred"},{"@language":"eu","@value":"Mihise"},{"@language":"sk","@value":"Plátno"},{"@language":"cs","@value":"Plátno"},{"@language":"pl","@value":"Kanwa"}]},{"@id":"http://data.europeana.eu/concept/47","@type":"skos:Concept","skos:broader":{"@id":"http://data.europeana.eu/concept/194"},"skos:exactMatch":[{"@id":"https://www.freebase.com/m/05qdh"},{"@id":"http://babelnet.org/rdf/s00060201n"},{"@id":"http://www.wikidata.org/entity/Q11629"},{"@id":"http://www.yso.fi/onto/yso/p8883"},{"@id":"http://iconclass.org/48C51"},{"@id":"http://id.ndl.go.jp/auth/ndlna/00564487"},{"@id":"http://cv.iptc.org/newscodes/mediatopic/20000035"},{"@id":"http://vocabularies.unesco.org/thesaurus/concept8418"},{"@id":"http://purl.org/bncf/tid/3793"},{"@id":"https://d-nb.info/gnd/4037213-3"},{"@id":"https://g.co/kg/m/05qdh"},{"@id":"http://vocab.getty.edu/aat/300054216"},{"@id":"http://dbpedia.org/resource/Painting"},{"@id":"http://datos.bne.es/resource/XX525398"}],"skos:note":[{"@language":"sk","@value":"Umenie tvorby obrazov pomocou farieb"},{"@language":"el","@value":"Πρακτική χρήσης χρώματος ή άλλου μέσου πάνω σε επιφάνεια"},{"@language":"en","@value":"Practice of applying paint, pigment, color or other medium to a surface"},{"@language":"cs","@value":"Druh výtvarného umění"},{"@language":"pl","@value":"Sztuka plastyczna"},{"@language":"ro","@value":"Practica de aplicare a vopselei, pigmentului, culorii sau a altui mediu pe o suprafață"},{"@language":"fi","@value":"Kuvataiteen ala"},{"@language":"es","@value":"Arte o proceso de aplicar pinturas a una superficie como un lienzo, para hacer una imagen u otra composición artística"},{"@language":"pt","@value":"Prática artística"},{"@language":"fr","@value":"Pratique artistique"},{"@language":"de","@value":"Klassische Gattung der bildenden Kunst"},{"@language":"bg","@value":"Вид изящно изобразително изкуство"},{"@language":"et","@value":"Kujutava kunsti liik"},{"@language":"nl","@value":"Vorm van vrije beeldende kunst, vervaardigd door een kunstschilder"},{"@language":"it","@value":"Arte che consiste nell'applicare dei pigmenti a un supporto"},{"@language":"ca","@value":"Art visual"},{"@language":"ru","@value":"Вид изобразительного искусства"},{"@language":"sv","@value":"Konstform"}],"skos:prefLabel":[{"@language":"mt","@value":"Pittura"},{"@language":"it","@value":"Pittura"},{"@language":"fi","@value":"Maalaustaide"},{"@language":"de","@value":"Malerei"},{"@language":"hu","@value":"Festőművészet"},{"@language":"en","@value":"Painting"},{"@language":"el","@value":"Ζωγραφική"},{"@language":"fr","@value":"Peinture"},{"@language":"eu","@value":"Margolaritza"},{"@language":"pt","@value":"Pintura"},{"@language":"ca","@value":"Pintura"},{"@language":"hr","@value":"Slikarstvo"},{"@language":"sl","@value":"Slikarstvo"},{"@language":"es","@value":"Pintura"},{"@language":"pl","@value":"Malarstwo"},{"@language":"et","@value":"Maalikunst"},{"@language":"cs","@value":"Malířství"},{"@language":"lv","@value":"Glezniecība"},{"@language":"da","@value":"Malerkunst"},{"@language":"sk","@value":"Maliarstvo"},{"@language":"lt","@value":"Tapyba"},{"@language":"bg","@value":"Живопис"},{"@language":"ga","@value":"Péintéireacht"},{"@language":"ro","@value":"Pictură"},{"@language":"sv","@value":"Målarkonst"},{"@language":"ru","@value":"Живопись"},{"@language":"nl","@value":"Schilderkunst"}]},{"@id":"http://data.europeana.eu/item/90402/SK_A_2344","@type":"edm:ProvidedCHO"},{"@id":"http://data.europeana.eu/organization/4579","@type":"foaf:Organization","skos:prefLabel":[{"@language":"nl","@value":"Rijksmuseum"},{"@language":"en","@value":"Rijksmuseum"}]},{"@id":"http://data.europeana.eu/proxy/europeana/90402/SK_A_2344","@type":"ore:Proxy","dc:format":{"@id":"http://data.europeana.eu/concept/2728"},"dc:type":{"@id":"http://data.europeana.eu/concept/47"},"dcterms:created":{"@id":"file:///usr/local/tomcat/webapps/#1660"},"edm:europeanaProxy":"true","edm:pid":{"@id":"file:///usr/local/tomcat/webapps/#pid_0"},"edm:type":"IMAGE","edm:year":"1660","ore:proxyFor":{"@id":"http://data.europeana.eu/item/90402/SK_A_2344"},"ore:proxyIn":{"@id":"http://data.europeana.eu/aggregation/europeana/90402/SK_A_2344"}},{"@id":"http://data.europeana.eu/proxy/provider/90402/SK_A_2344","@type":"ore:Proxy","dc:coverage":[{"@language":"en","@value":"third quarter 17th century"},{"@language":"nl","@value":"derde kwart 17e eeuw"}],"dc:description":[{"@language":"nl","@value":"Geheel verdiept in haar werk schenkt een dienstmeisje melk in. Behalve de witte melkstraal lijkt niets te bewegen. Die alledaagse handeling balde Vermeer samen tot een indrukwekkend schilderij – als een beeld staat de figuur vrij in de lichte ruimte. Vermeer had oog voor hoe het licht in honderden kleurige puntjes over de voorwerpen speelt."},{"@language":"en","@value":"A maidservant pours milk, entirely absorbed in her work. Except for the stream of milk, everything else is still. Vermeer took this simple everyday activity and made it the subject of an impressive painting – the woman stands like a statue in the brightly lit room. Vermeer also had an eye for how light by means of hundreds of colourful dots plays over the surface of objects."}],"dc:format":[{"@language":"nl","@value":"doek"},{"@language":"en","@value":"oil paint (paint)"},{"@language":"en","@value":"canvas"},{"@id":"http://vocab.getty.edu/aat/300014078"},{"@language":"nl","@value":"olieverf"},{"@id":"http://vocab.getty.edu/aat/300015050"}],"dc:identifier":["http://hdl.handle.net/10934/RM0001.COLLECT.6417","SK-A-2344"],"dc:language":"nl","dc:publisher":"Rijksmuseum","dc:rights":["Publiek Domein","Public Domain"],"dc:subject":[{"@id":"http://iconclass.org/41A773"},{"@id":"http://iconclass.org/41B23"},{"@id":"http://iconclass.org/41C621"},{"@id":"http://iconclass.org/47I22311"},{"@id":"http://iconclass.org/41C222"},{"@id":"http://iconclass.org/41C6413"}],"dc:title":[{"@language":"nl","@value":"Het melkmeisje"},{"@language":"en","@value":"The Milkmaid"}],"dc:type":[{"@language":"en","@value":"painting"},{"@language":"nl","@value":"schilderij"},{"@id":"http://vocab.getty.edu/aat/300177435"}],"dcterms:created":"1660","dcterms:extent":[{"@language":"nl","@value":"breedte 41 cm"},{"@language":"en","@value":"height 45.5 cm"},{"@language":"en","@value":"width 41 cm"},{"@language":"nl","@value":"hoogte 45,5 cm"}],"dcterms:isPartOf":["collection: paintings","collectie: schilderijen"],"dcterms:medium":[{"@language":"nl","@value":"Aankoop met steun van de Vereniging Rembrandt"},{"@language":"en","@value":"Purchased with the support of the Vereniging Rembrandt"}],"edm:europeanaProxy":"false","edm:type":"IMAGE","ore:proxyFor":{"@id":"http://data.europeana.eu/item/90402/SK_A_2344"},"ore:proxyIn":{"@id":"http://data.europeana.eu/aggregation/provider/90402/SK_A_2344"}},{"@id":"http://hdl.handle.net/10934/RM0001.COLLECT.6417","@type":["edm:FullTextResource","edm:WebResource"],"ebucore:fileByteSize":{"@type":"http://www.w3.org/2001/XMLSchema#long","@value":"63563"},"ebucore:hasMimeType":"text/html"},{"@id":"http://semium.org/time/AD2xxx","@type":"edm:TimeSpan","dcterms:isPartOf":{"@id":"http://semium.org/time/ChronologicalPeriod"},"skos:prefLabel":[{"@language":"fr","@value":"2e millénaire après J.-C."},{"@language":"en","@value":"Second millenium AD, years 1001-2000"},{"@language":"en","@value":"Second millenium AD"}]},{"@id":"https://iiif.europeana.eu/presentation/90402/SK_A_2344/manifest","@type":["http://iiif.io/api/presentation/3#Manifest","edm:WebResource"]},{"@id":"https://lh3.googleusercontent.com/-pGNtXiSwRShKc9U6djlF7JB3cWtqONNmpnQ7U_ieUjn7iwIP4ziNGt7LGFxfN0IqGzoLlEeIKNoERm6qTQuId9GdUo=s0","@type":"edm:WebResource","dc:format":"image/jpeg","dc:rights":[{"@language":"nl","@value":"Publiek Domein"},{"@language":"en","@value":"Public Domain"}],"dcterms:created":"2013","dcterms:isReferencedBy":{"@id":"https://iiif.europeana.eu/presentation/90402/SK_A_2344/manifest"},"ebucore:fileByteSize":{"@type":"http://www.w3.org/2001/XMLSchema#long","@value":"4781655"},"ebucore:hasMimeType":"image/jpeg","ebucore:height":2548,"ebucore:orientation":"portrait","ebucore:width":2261,"edm:componentColor":[{"@type":"http://www.w3.org/2001/XMLSchema#hexBinary","@value":"#C0C0C0"},{"@type":"http://www.w3.org/2001/XMLSchema#hexBinary","@value":"#696969"},{"@type":"http://www.w3.org/2001/XMLSchema#hexBinary","@value":"#556B2F"},{"@type":"http://www.w3.org/2001/XMLSchema#hexBinary","@value":"#800000"},{"@type":"http://www.w3.org/2001/XMLSchema#hexBinar