# MCP transport: "sse" for HTTP/SSE (remote clients), omit for stdio (local)
MCP_TRANSPORT=sse

# MCP SSE server port (optional, default: 8081)
MCP_PORT=8081

# Public base URL advertised to SSE clients (optional, defaults to http://localhost:$MCP_PORT)
MCP_BASE_URL=http://localhost:8081

# Docs + registration API server port (optional, default: 8080)
DOCS_PORT=8080

# SQLite database file path (optional, default: uniche.db)
DB_PATH=uniche.db

# Keycloak realm issuing access tokens (optional, default: deployed UNICHE IdP)
OIDC_ISSUER=https://idp.uniche-eccch.eu/realms/uniche

# Dev only: lets Swagger UI's Authorize dialog log in with username/password
# via /docs/token. Leave empty in any shared deployment.
DEV_LOGIN_CLIENT_ID=dev-cli

# Repository storage (Postgres). Required: the server will not start without POSTGRES_USER and POSTGRES_PASSWORD.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=uniche
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Where the Repository keeps uploaded file bytes (optional)
REPOSITORY_FILES_DIR=uniche-data/repository-files

# Repository browser at /repo, behind basic auth (optional; off unless both are set)
BROWSER_USER=
BROWSER_PASSWORD=

# Europeana Record API key (optional, defaults to the demo key "api2demo" - dev only)
EUROPEANA_API_KEY=api2demo

# ECCCH Knowledge Base (KBMS) and the triplestore HDTs are imported from (optional)
ECCCH_KB_URL=https://echoes-kb-api-route-echoes-graphs-production.apps.dcw1.paas.psnc.pl
ECCCH_TRIPLESTORE_ID=6a2abf6b5d6646ff24522299

# Dev only: a personal EGI Check-in refresh token from https://aai-demo.egi.eu/token/.
# Every KBMS call runs as that person. ECCCH import is off when it is empty.
# Access tokens are fetched with it and kept in memory. Never commit it.
EGI_TOKEN_URL=https://aai-demo.egi.eu/auth/realms/egi/protocol/openid-connect/token
EGI_CLIENT_ID=token-portal
EGI_REFRESH_TOKEN=
